+mozService UiThemeManager
    activeTheme: IUiTheme
    +mozFunction SetTheme(themeName: Text) -> UiResult
        nextTheme := UiThemeCatalog.Load(themeName)
        if nextTheme == null then return NotFound
        activeTheme := nextTheme
        for each window in UiHandler.windows
            window.Root.Invalidate(Render | Measure | Accessibility)
        end
        return Ok
    +mozEnd
    +mozFunction ResolveColor(token: Text) -> UiColor
        return activeTheme.GetColor(token)
    +mozEnd
    +mozFunction ResolveStyle(name: Text, targetType: Text) -> UiStyle
        style := activeTheme.GetStyle(name)
        require style.targetType == targetType or style.targetType == "*"
        return style
    +mozEnd
+mozEnd

