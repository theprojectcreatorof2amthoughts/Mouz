# -----------------------------------------------------------------------------
# 10. Rendering and retained frame composition
# -----------------------------------------------------------------------------
+mozEnum UiRenderLayer
    Background
    Content
    Overlay
    Adornment
    Focus
+mozEnd
+mozRecord UiRenderCommand
    kind: UiRenderCommandKind
    bounds: UiRect
    clip: UiRect
    brush: UiBrush
    resource: UiResourceRef
    text: Text
    transform: UiTransform
    opacity: Float = 1.0
+mozEnd
+mozRecord UiFrame
    windowId: Text
    sequence: UInt64
    viewport: UiSize
    dpi: Float
    commands: UiRenderCommandList
    dirtyRegions: UiRectList
+mozEnd

+mozInterface IUiRenderer
    BeginFrame(window: UiWindow) -> UiFrame
    RenderNode(node: IUiNode, frame: UiFrame) -> UiResult
    EndFrame(frame: UiFrame) -> UiResult
+mozEnd

+mozService UiRenderer implements IUiRenderer
    +mozFunction BeginFrame(window: UiWindow) -> UiFrame
        frame := UiFrame.Create(window.id, window.NextFrameSequence())
        frame.viewport := window.ClientSize
        frame.dpi := window.Dpi
        frame.dirtyRegions := window.ConsumeDirtyRegions()
        return frame
    +mozEnd
    +mozFunction RenderNode(node: IUiNode, frame: UiFrame) -> UiResult
        if node.visibility != Visible then return Ok
        if not IntersectsAny(node.Bounds, frame.dirtyRegions) then return Ok
        frame.commands.PushClip(node.ClipBounds)
        node.Render(frame)
        for each child in node.Children
            RenderNode(child, frame)
        end
        frame.commands.PopClip()
        return Ok
    +mozEnd
    +mozFunction EndFrame(frame: UiFrame) -> UiResult
        return UiHandler.backend.SubmitFrame(frame.windowId, frame)
    +mozEnd
+mozEnd

+mozService UiRenderScheduler
    +mozFunction RenderWindow(window: UiWindow) -> UiResult
        if not window.IsRenderDirty() then return Ok
        frame := UiRenderer.BeginFrame(window)
        result := UiRenderer.RenderNode(window.Root, frame)
        if result != Ok then return result
        result := UiRenderer.EndFrame(frame)
        if result == Ok then window.ClearRenderInvalidation()
        return result
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 11. Input routing, hit testing, and focus
# -----------------------------------------------------------------------------
+mozEnum UiInputKind
    PointerMove
    PointerDown
    PointerUp
    PointerCancel
    Wheel
    KeyDown
    KeyUp
    TextInput
    ImeStart
    ImeUpdate
    ImeCommit
    TouchStart
    TouchMove
    TouchEnd
+mozEnd
+mozEnum UiPointerDevice
    Mouse
    Touch
    Pen
    Unknown
+mozEnd
+mozRecord UiInputEvent
    kind: UiInputKind
    timestamp: UInt64
    pointerId: UInt32 = 0
    device: UiPointerDevice = Unknown
    position: UiPoint = UiPoint.Zero
    delta: UiPoint = UiPoint.Zero
    key: UiKey = None
    modifiers: UiModifiers = None
    text: Text = ""
    handled: Bool = false
    cancelled: Bool = false
+mozEnd

+mozInterface IUiInputHandler
    HandleInput(event: UiInputEvent) -> UiResult
    HitTest(point: UiPoint) -> IUiNode
    CapturePointer(pointerId: UInt32, node: IUiNode) -> UiResult
    ReleasePointer(pointerId: UInt32) -> UiResult
+mozEnd

+mozService UiInputRouter implements IUiInputHandler
    pointerCapture := Map<UInt32, IUiNode>.Create()
    +mozFunction HandleInput(event: UiInputEvent) -> UiResult
        target := pointerCapture.GetOrNull(event.pointerId)
        if target == null then target := HitTest(event.position)
        if target == null then return Ok
        RouteCapture(event, target)
        if not event.handled and not event.cancelled then RouteTarget(event, target)
        if not event.handled and not event.cancelled then RouteBubble(event, target)
        if event.kind == PointerUp or event.kind == PointerCancel then
            ReleasePointer(event.pointerId)
        end
        return Ok
    +mozEnd
    +mozFunction HitTest(point: UiPoint) -> IUiNode
        return HitTestNode(UiHandler.ActiveWindow.Root, point)
    +mozEnd
    +mozFunction HitTestNode(node: IUiNode, point: UiPoint) -> IUiNode
        if node.visibility != Visible or not node.enabled then return null
        if not RectContains(node.Bounds, point) then return null
        for each child in node.Children.Reverse()
            found := HitTestNode(child, point)
            if found != null then return found
        end
        if node.IsHitTestVisible then return node
        return null
    +mozEnd
    +mozFunction CapturePointer(pointerId: UInt32, node: IUiNode) -> UiResult
        if pointerCapture.Contains(pointerId) then return AlreadyExists
        pointerCapture[pointerId] := node
        return Ok
    +mozEnd
    +mozFunction ReleasePointer(pointerId: UInt32) -> UiResult
        pointerCapture.Remove(pointerId)
        return Ok
    +mozEnd
+mozEnd

+mozService UiFocusManager
    focusedNode: IUiNode = null
    +mozFunction Focus(node: IUiNode) -> UiResult
        if node == null or not node.IsFocusable or not node.IsEffectivelyEnabled then return InvalidArgument
        previous := focusedNode
        if previous == node then return Ok
        if previous != null then previous.RaiseEvent(LostFocus)
        focusedNode := node
        node.RaiseEvent(GotFocus)
        node.Invalidate(Render | Accessibility)
        return Ok
    +mozEnd
    +mozFunction MoveNext(reverse: Bool = false) -> UiResult
        candidates := UiHandler.ActiveWindow.Root.GetFocusableNodesInTabOrder()
        next := candidates.NextAfter(focusedNode, reverse)
        if next == null then return Ok
        return Focus(next)
    +mozEnd
    +mozFunction Clear() -> UiResult
        if focusedNode != null then focusedNode.RaiseEvent(LostFocus)
        focusedNode := null
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 12. Event declarations and command routing
# -----------------------------------------------------------------------------
+mozEnum UiEventPhase
    Capture
    Target
    Bubble
+mozEnd
+mozRecord UiRoutedEvent
    name: Text
    source: IUiNode
    target: IUiNode
    phase: UiEventPhase
    handled: Bool = false
    cancelled: Bool = false
    payload: UiValue = Null
+mozEnd
+mozInterface IUiCommand
    CanExecute(parameter: UiValue) -> Bool
    Execute(parameter: UiValue) -> UiResult
+mozEnd

+mozService UiEventManager
    +mozFunction Raise(target: IUiNode, eventName: Text, payload: UiValue = Null) -> UiResult
        require target != null
        route := BuildAncestorRoute(target)
        event := UiRoutedEvent(eventName, target, target, Capture, false, false, payload)
        for each node in route.RootToParent
            node.InvokeHandlers(event, Capture)
            if event.handled or event.cancelled then return Ok
        end
        event.phase := Target
        target.InvokeHandlers(event, Target)
        if event.handled or event.cancelled then return Ok
        event.phase := Bubble
        for each node in route.ParentToRoot
            node.InvokeHandlers(event, Bubble)
            if event.handled or event.cancelled then break
        end
        return Ok
    +mozEnd
+mozEnd

+mozService UiCommandManager
    +mozFunction Execute(command: IUiCommand, parameter: UiValue) -> UiResult
        if command == null then return InvalidArgument
        if not command.CanExecute(parameter) then return EventRejected
        return command.Execute(parameter)
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 13. Window manager and native lifetime
# -----------------------------------------------------------------------------
+mozEnum UiWindowState
    Normal
    Minimized
    Maximized
    Fullscreen
+mozEnd
+mozRecord WindowSpec
    id: Text
    title: Text = "Mouz Window"
    bounds: UiRect = UiRect(100, 100, 960, 640)
    minimumSize: UiSize = UiSize(320, 240)
    maximumSize: UiSize = UiSize.Infinite
    resizable: Bool = true
    owner: UiWindow = null
    startupLocation: UiStartupLocation = CenterOwner
    style: UiWindowStyle = Standard
    root: IUiNode = null
+mozEnd

+mozService UiWindow
    id: Text
    nativeHandle: NativeWindowHandle
    Root: IUiNode
    state: UiWindowState = Normal
    Dpi: Float = 96
    ClientSize: UiSize
    +mozFunction Show() -> UiResult
        require nativeHandle != null
        return backend.ShowWindow(nativeHandle)
    +mozEnd
    +mozFunction Close() -> UiResult
        if EventManager.Raise(Root, "closing") == EventRejected then return EventRejected
        backend.DestroyNativeWindow(nativeHandle)
        Root.Dispose()
        state := Disposed
        return Ok
    +mozEnd
    +mozFunction LayoutIfDirty() -> UiResult
        if not Root.IsMeasureDirty() and not Root.IsArrangeDirty() then return Ok
        return UiLayoutEngine.Layout(Root, ClientSize)
    +mozEnd
    +mozFunction RenderIfDirty() -> UiResult
        return UiRenderScheduler.RenderWindow(this)
    +mozEnd
    +mozFunction CommitPendingChanges() -> UiResult
        return UiPropertyTransaction.CommitFor(this)
    +mozEnd
+mozEnd

+mozService UiWindowRegistry
    entries := Map<Text, UiWindow>.Create()
    +mozFunction Add(window: UiWindow) -> UiResult
        if entries.Contains(window.id) then return AlreadyExists
        entries[window.id] := window
        return Ok
    +mozEnd
    +mozFunction Remove(id: Text) -> UiResult
        if not entries.Contains(id) then return NotFound
        entries.Remove(id)
        return Ok
    +mozEnd
    +mozFunction Get(id: Text) -> UiWindow
        return entries.GetOrNull(id)
    +mozEnd
    +mozFunction All() -> UiWindowList
        return entries.Values().ToList()
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 14. Accessibility tree and semantics
# -----------------------------------------------------------------------------
+mozEnum UiAccessibilityRole
    None
    Window
    Group
    Button
    Text
    TextField
    CheckBox
    RadioButton
    Slider
    ProgressBar
    Image
    List
    ListItem
    Menu
    MenuItem
    Tab
    TabPanel
    ScrollArea
+mozEnd
+mozRecord UiAccessibilitySpec
    role: UiAccessibilityRole = None
    label: Text = ""
    description: Text = ""
    hint: Text = ""
    isHidden: Bool = false
    isLiveRegion: Bool = false
    livePoliteness: UiLivePoliteness = Off
    valueText: Text = ""
    positionInSet: Int32 = 0
    setSize: Int32 = 0
+mozEnd

+mozInterface IUiAccessibilityProvider
    BuildAccessibilityNode(node: IUiNode) -> UiAccessibilityNode
    NotifyAccessibilityChanged(node: IUiNode, property: Text) -> UiResult
+mozEnd

+mozService UiAccessibility
    +mozFunction BuildAccessibilityNode(node: IUiNode) -> UiAccessibilityNode
        if node.accessibility.isHidden then return null
        result := UiAccessibilityNode.Create()
        result.role := node.accessibility.role
        result.name := ResolveAccessibleName(node)
        result.description := node.accessibility.description
        result.value := ResolveAccessibleValue(node)
        for each child in node.Children
            childNode := BuildAccessibilityNode(child)
            if childNode != null then result.children.Append(childNode)
        end
        return result
    +mozEnd
    +mozFunction NotifyAccessibilityChanged(node: IUiNode, property: Text) -> UiResult
        backend.AccessibilityBridge.Notify(node.id, property)
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 15. Resource loading and caching
# -----------------------------------------------------------------------------
+mozEnum UiResourceKind
    Image
    Font
    Icon
    Template
    Style
    Data
+mozEnd
+mozRecord UiResourceRef
    uri: Text
    kind: UiResourceKind
    scale: Float = 1.0
+mozEnd

+mozInterface IUiResourceLoader
    Load(reference: UiResourceRef) -> UiResource
    LoadAsync(reference: UiResourceRef, callback: UiResourceCallback) -> UiRequest
    Cancel(request: UiRequest) -> UiResult
+mozEnd

+mozService UiResourceStore
    cache := Map<Text, UiResource>.Create()
    requests := Map<UInt64, UiRequest>.Create()
    +mozFunction Load(reference: UiResourceRef) -> UiResource
        key := NormalizeResourceUri(reference.uri)
        if cache.Contains(key) then return cache[key]
        resource := ResourceLoader.Load(reference)
        if resource == null then fail ResourceMissing(reference.uri)
        cache[key] := resource
        return resource
    +mozEnd
    +mozFunction Invalidate(uri: Text) -> UiResult
        cache.Remove(NormalizeResourceUri(uri))
        return Ok
    +mozEnd
    +mozFunction Clear() -> UiResult
        for each resource in cache.Values()
            resource.Release()
        end
        cache.Clear()
        return Ok
    +mozEnd
+mozEnd

# Resource security: resolve paths beneath resourceRoot; reject traversal, unsupported
# schemes, oversized decoded images, and untrusted executable templates.
+mozService UiResourcePolicy
    allowedSchemes := ["asset", "file", "https", "data"]
    maxImageBytes := 33554432
    maxImageDimension := 16384
    +mozFunction Validate(reference: UiResourceRef) -> UiResult
        if not allowedSchemes.Contains(reference.uri.Scheme) then return Unsupported
        if reference.uri.ContainsPathTraversal then return InvalidArgument
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 16. Text shaping, input method, and clipboard
# -----------------------------------------------------------------------------
+mozRecord UiFontSpec
    family: Text = "system-ui"
    size: Float = 14
    weight: UiFontWeight = Normal
    italic: Bool = false
    stretch: Float = 1
+mozEnd
+mozInterface IUiTextService
    Measure(text: Text, font: UiFontSpec, width: Float) -> UiSize
    Draw(text: Text, font: UiFontSpec, bounds: UiRect, brush: UiBrush) -> UiResult
    CaretAt(text: Text, font: UiFontSpec, point: UiPoint) -> Int32
+mozEnd

+mozService UiTextInputService
    +mozFunction InsertText(target: IUiNode, value: Text) -> UiResult
        require target.IsTextEditable
        next := target.TextBeforeSelection + value + target.TextAfterSelection
        target.SetProperty("text", next)
        target.SetSelection(target.SelectionStart + value.Length, 0)
        return Ok
    +mozEnd
    +mozFunction DeleteBackward(target: IUiNode) -> UiResult
        if target.SelectionLength > 0 then return target.DeleteSelection()
        if target.SelectionStart == 0 then return Ok
        target.DeleteRange(target.SelectionStart - 1, 1)
        return Ok
    +mozEnd
    +mozFunction CommitIme(target: IUiNode, value: Text) -> UiResult
        return InsertText(target, value)
    +mozEnd
+mozEnd

+mozService UiClipboard
    +mozFunction Copy(value: Text) -> UiResult
        return backend.SetClipboardText(value)
    +mozEnd
    +mozFunction Paste() -> Text
        return backend.GetClipboardText()
    +mozEnd
+mozEnd

