# Mouz UI Handler Core
# File: uihandle.mozhl
# Version: 0.1.0-draft
#
# This file is the first executable-contract draft for Mouz's UI handler.
# It is intentionally independent of Shay, SHUI, gshai, and shaii.
# JavaScript remains the browser execution layer; this handler does not replace it.
# Windows-native controls are intended to be provided by the Mouz native runtime.
#
# Syntax note: the repository has not yet frozen the .mozhl grammar. The declarations
# below establish the proposed handler vocabulary and its runtime contract. The parser
# must reject unknown directives rather than silently ignoring them.

+mozUihandler |uihandle.mozhl|
+mozHandlerVersion := "0.1.0-draft"
+mozHandlerName := "Mouz.UI.Core"
+mozHandlerKind := UI
+mozHandlerABI := 1
+mozHandlerEntry := UiHandler.Initialize
+mozHandlerShutdown := UiHandler.Shutdown
+mozHandlerThread := UI
+mozHandlerErrors := Strict
+mozHandlerOwnership := Explicit
+mozHandlerNullPolicy := Reject
+mozHandlerLayoutPolicy := MeasureThenArrange
+mozHandlerRenderPolicy := RetainedTree
+mozHandlerEventPolicy := CaptureTargetBubble
+mozHandlerStatePolicy := Transactional

+#makeUicomp [<|
    uiStructuredef:= .NET
    uiStat:=1
    doComp |+*WinComp|
|>]

# -----------------------------------------------------------------------------
# 01. Public contract and lifecycle
# -----------------------------------------------------------------------------
+mozNamespace |Mouz.UI|
+mozImport |Mouz.Core.Types|
+mozImport |Mouz.Core.Diagnostics|
+mozImport |Mouz.Runtime.Dispatch|

+mozEnum UiHandlerState
    Created
    Initializing
    Ready
    ShuttingDown
    Stopped
    Faulted
+mozEnd

+mozEnum UiNodeState
    Detached
    Attaching
    Attached
    Updating
    Detaching
    Disposed
    Faulted
+mozEnd

+mozEnum UiResult
    Ok
    InvalidArgument
    InvalidState
    NotFound
    AlreadyExists
    Unsupported
    LayoutFailed
    RenderFailed
    EventRejected
    ResourceMissing
    OutOfMemory
    InternalError
+mozEnd

+mozRecord UiHandlerOptions
    backend: UiBackendKind = Auto
    strictMode: Bool = true
    enableAccessibility: Bool = true
    enableDiagnostics: Bool = true
    frameRateLimit: UInt32 = 120
    logicalDpi: Float = 96.0
    resourceRoot: Path = "."
    themeName: Text = "system"
+mozEnd

+mozInterface IUiHandler
    Initialize(options: UiHandlerOptions) -> UiResult
    Shutdown() -> UiResult
    GetState() -> UiHandlerState
    GetCapabilities() -> UiCapabilities
    CreateWindow(spec: WindowSpec) -> UiWindow
    DestroyWindow(window: UiWindow) -> UiResult
    PumpEvents(timeoutMs: UInt32) -> UiResult
    Flush() -> UiResult
+mozEnd

+mozService UiHandler implements IUiHandler
    state := Created
    options := UiHandlerOptions.Default
    windows := UiWindowRegistry.Create()
    dispatcher := UiDispatcher.Create()
    resources := UiResourceStore.Create()
    themes := UiThemeManager.Create()
    diagnostics := UiDiagnostics.Create()
    accessibility := UiAccessibility.Create()

    +mozFunction Initialize(options: UiHandlerOptions) -> UiResult
        require state == Created
        validate options
        state := Initializing
        select backend options.backend
        initialize dispatcher
        initialize resource store
        initialize theme manager
        initialize accessibility when options.enableAccessibility
        initialize diagnostics when options.enableDiagnostics
        state := Ready
        return Ok
    +mozEnd

    +mozFunction Shutdown() -> UiResult
        require state == Ready or state == Faulted
        state := ShuttingDown
        close all registered windows
        dispose all root visual trees
        release theme resources
        release resource store
        stop dispatcher
        state := Stopped
        return Ok
    +mozEnd

    +mozFunction GetState() -> UiHandlerState
        return state
    +mozEnd

    +mozFunction Flush() -> UiResult
        require state == Ready
        dispatcher.Drain()
        for each window in windows
            window.CommitPendingChanges()
            window.LayoutIfDirty()
            window.RenderIfDirty()
        end
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 02. Backends and platform capability negotiation
# -----------------------------------------------------------------------------
+mozEnum UiBackendKind
    Auto
    WindowsNative
    Browser
    Headless
+mozEnd

+mozRecord UiCapabilities
    backend: UiBackendKind
    supportsNativeWindows: Bool
    supportsBrowserDom: Bool
    supportsPointerInput: Bool
    supportsTouchInput: Bool
    supportsKeyboardInput: Bool
    supportsClipboard: Bool
    supportsIme: Bool
    supportsAccessibility: Bool
    supportsGpuComposition: Bool
    supportsNativeDialogs: Bool
    maxTextureSize: UInt32
+mozEnd

+mozInterface IUiBackend
    Probe() -> UiCapabilities
    Start(options: UiHandlerOptions) -> UiResult
    Stop() -> UiResult
    CreateNativeWindow(spec: WindowSpec) -> NativeWindowHandle
    DestroyNativeWindow(handle: NativeWindowHandle) -> UiResult
    SubmitFrame(window: NativeWindowHandle, frame: UiFrame) -> UiResult
    SetCursor(cursor: UiCursorKind) -> UiResult
    SetClipboardText(value: Text) -> UiResult
    GetClipboardText() -> Text
+mozEnd

+mozService BackendSelector
    +mozFunction Select(kind: UiBackendKind) -> IUiBackend
        if kind == Auto
            if Platform.IsWindows() then return WindowsBackend.Create()
            if Platform.IsBrowser() then return BrowserBackend.Create()
            return HeadlessBackend.Create()
        end
        if kind == WindowsNative then return WindowsBackend.Create()
        if kind == Browser then return BrowserBackend.Create()
        if kind == Headless then return HeadlessBackend.Create()
        fail UnsupportedBackend
    +mozEnd
+mozEnd

+mozService WindowsBackend implements IUiBackend
    nativeApi := Win32
    windowClass := "Mouz.UI.Window"
    +mozFunction Probe() -> UiCapabilities
        return capabilities(nativeWindows=true, browserDom=false, pointer=true,
            touch=true, keyboard=true, clipboard=true, ime=true, accessibility=true,
            gpu=true, nativeDialogs=true)
    +mozEnd
    +mozFunction Start(options: UiHandlerOptions) -> UiResult
        register window class windowClass
        initialize message queue
        initialize composition device when available
        return Ok
    +mozEnd
    +mozFunction Stop() -> UiResult
        release composition device
        unregister window class when unused
        return Ok
    +mozEnd
    +mozFunction CreateNativeWindow(spec: WindowSpec) -> NativeWindowHandle
        return Win32.CreateWindow(spec.title, spec.bounds, spec.style, spec.owner)
    +mozEnd
    +mozFunction SubmitFrame(window: NativeWindowHandle, frame: UiFrame) -> UiResult
        return Win32.Compositor.Present(window, frame)
    +mozEnd
+mozEnd

+mozService BrowserBackend implements IUiBackend
    executionLayer := JavaScript
    domRoot := Document.CreateRoot()
    +mozFunction Probe() -> UiCapabilities
        return capabilities(nativeWindows=false, browserDom=true, pointer=true,
            touch=true, keyboard=true, clipboard=BrowserClipboard.Available(),
            ime=true, accessibility=true, gpu=true, nativeDialogs=false)
    +mozEnd
    +mozFunction Start(options: UiHandlerOptions) -> UiResult
        attach domRoot to document.body
        install browser event bridge
        install resize observer
        return Ok
    +mozEnd
    +mozFunction Stop() -> UiResult
        remove browser event bridge
        detach domRoot
        return Ok
    +mozEnd
    +mozFunction SubmitFrame(window: NativeWindowHandle, frame: UiFrame) -> UiResult
        JavaScript.MouzDomBridge.Apply(window, frame)
        return Ok
    +mozEnd
+mozEnd

+mozService HeadlessBackend implements IUiBackend
    +mozFunction Probe() -> UiCapabilities
        return capabilities(nativeWindows=false, browserDom=false, pointer=false,
            touch=false, keyboard=false, clipboard=false, ime=false,
            accessibility=false, gpu=false, nativeDialogs=false)
    +mozEnd
    +mozFunction Start(options: UiHandlerOptions) -> UiResult
        create deterministic test surface
        return Ok
    +mozEnd
    +mozFunction Stop() -> UiResult
        destroy deterministic test surface
        return Ok
    +mozEnd
    +mozFunction SubmitFrame(window: NativeWindowHandle, frame: UiFrame) -> UiResult
        TestSurface.Record(window, frame)
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 03. Core values, geometry, and measurement
# -----------------------------------------------------------------------------
+mozRecord UiPoint
    x: Float
    y: Float
+mozEnd
+mozRecord UiSize
    width: Float
    height: Float
+mozEnd
+mozRecord UiRect
    x: Float
    y: Float
    width: Float
    height: Float
+mozEnd
+mozRecord UiThickness
    left: Float = 0
    top: Float = 0
    right: Float = 0
    bottom: Float = 0
+mozEnd
+mozRecord UiCornerRadius
    topLeft: Float = 0
    topRight: Float = 0
    bottomRight: Float = 0
    bottomLeft: Float = 0
+mozEnd
+mozRecord UiConstraints
    minWidth: Float = 0
    minHeight: Float = 0
    maxWidth: Float = Infinity
    maxHeight: Float = Infinity
+mozEnd
+mozEnum UiUnit
    Pixel
    Dip
    Percent
    Auto
    Star
+mozEnd
+mozRecord UiLength
    value: Float
    unit: UiUnit
+mozEnd

+mozFunction RectContains(rect: UiRect, point: UiPoint) -> Bool
    return point.x >= rect.x and point.y >= rect.y
        and point.x <= rect.x + rect.width
        and point.y <= rect.y + rect.height
+mozEnd

+mozFunction RectIntersect(a: UiRect, b: UiRect) -> UiRect
    left := max(a.x, b.x)
    top := max(a.y, b.y)
    right := min(a.x + a.width, b.x + b.width)
    bottom := min(a.y + a.height, b.y + b.height)
    if right < left or bottom < top then return UiRect.Empty
    return UiRect(left, top, right - left, bottom - top)
+mozEnd

+mozFunction ResolveLength(length: UiLength, available: Float, dpi: Float) -> Float
    match length.unit
        Pixel: return length.value
        Dip: return length.value * dpi / 96.0
        Percent: return available * length.value / 100.0
        Auto: return NaN
        Star: return NaN
    end
+mozEnd

# -----------------------------------------------------------------------------
# 04. Visual tree and component model
# -----------------------------------------------------------------------------
+mozEnum UiVisibility
    Visible
    Hidden
    Collapsed
+mozEnd
+mozEnum UiOrientation
    Horizontal
    Vertical
+mozEnd
+mozEnum UiOverflow
    Visible
    Clip
    Scroll
    Auto
+mozEnd
+mozEnum UiHorizontalAlignment
    Start
    Center
    End
    Stretch
+mozEnd
+mozEnum UiVerticalAlignment
    Top
    Center
    Bottom
    Stretch
+mozEnd

+mozRecord UiComponentSpec
    id: Text
    type: Text
    name: Text = ""
    key: Text = ""
    enabled: Bool = true
    visible: UiVisibility = Visible
    width: UiLength = Auto
    height: UiLength = Auto
    minSize: UiSize = UiSize.Zero
    maxSize: UiSize = UiSize.Infinite
    margin: UiThickness = UiThickness.Zero
    padding: UiThickness = UiThickness.Zero
    horizontalAlignment: UiHorizontalAlignment = Stretch
    verticalAlignment: UiVerticalAlignment = Stretch
    style: UiStyleRef = None
    accessibility: UiAccessibilitySpec = Default
+mozEnd

+mozInterface IUiNode
    GetId() -> Text
    GetTypeName() -> Text
    GetParent() -> IUiNode
    GetChildren() -> UiNodeList
    AddChild(child: IUiNode) -> UiResult
    RemoveChild(child: IUiNode) -> UiResult
    FindById(id: Text) -> IUiNode
    SetProperty(name: Text, value: UiValue) -> UiResult
    GetProperty(name: Text) -> UiValue
    Invalidate(flags: UiInvalidation) -> UiResult
    Dispose() -> UiResult
+mozEnd

+mozService UiNode implements IUiNode
    id: Text
    typeName: Text
    parent: IUiNode = null
    children: UiNodeList = UiNodeList.Empty
    properties: UiPropertyBag = UiPropertyBag.Create()
    state: UiNodeState = Detached
    invalidation: UiInvalidation = None
    +mozFunction AddChild(child: IUiNode) -> UiResult
        require state != Disposed
        require child != null
        require child.GetParent() == null
        require not child.IsAncestorOf(this)
        children.Append(child)
        child.SetParent(this)
        child.AttachToTreeWhenAttached()
        Invalidate(Measure | Arrange | Render | Accessibility)
        return Ok
    +mozEnd
    +mozFunction RemoveChild(child: IUiNode) -> UiResult
        if not children.Contains(child) then return NotFound
        child.DetachFromTree()
        children.Remove(child)
        child.SetParent(null)
        Invalidate(Measure | Arrange | Render | Accessibility)
        return Ok
    +mozEnd
    +mozFunction FindById(target: Text) -> IUiNode
        if id == target then return this
        for each child in children
            found := child.FindById(target)
            if found != null then return found
        end
        return null
    +mozEnd
    +mozFunction Dispose() -> UiResult
        if state == Disposed then return Ok
        state := Detaching
        for each child in children snapshot
            child.Dispose()
        end
        children.Clear()
        properties.Clear()
        state := Disposed
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 05. Component registration and factories
# -----------------------------------------------------------------------------
+mozInterface IUiComponentFactory
    GetComponentName() -> Text
    Create(spec: UiComponentSpec) -> IUiNode
    Validate(spec: UiComponentSpec) -> UiValidationResult
+mozEnd

+mozService UiComponentRegistry
    factories := Map<Text, IUiComponentFactory>.Create()
    +mozFunction Register(factory: IUiComponentFactory) -> UiResult
        require factory != null
        name := factory.GetComponentName()
        if factories.Contains(name) then return AlreadyExists
        factories.Add(name, factory)
        return Ok
    +mozEnd
    +mozFunction Create(spec: UiComponentSpec) -> IUiNode
        factory := factories.GetOrNull(spec.type)
        if factory == null then fail UnknownComponent(spec.type)
        result := factory.Validate(spec)
        if not result.IsValid then fail InvalidComponent(result)
        return factory.Create(spec)
    +mozEnd
    +mozFunction Contains(name: Text) -> Bool
        return factories.Contains(name)
    +mozEnd
    +mozFunction Names() -> TextList
        return factories.Keys().SortOrdinal()
    +mozEnd
+mozEnd

# Built-in component declarations. Factories own validation, defaults, and lifecycle.
+mozBuiltin Button : UiControl
    properties := [text, command, commandParameter, isDefault, isCancel,
        icon, iconPlacement, clickMode, repeatDelay, repeatInterval]
    events := [click, pressed, released, commandFailed]
    behaviors := [focusable, keyboardActivate, pointerCapture, accessibleButton]
+mozEnd
+mozBuiltin TextBlock : UiElement
    properties := [text, fontFamily, fontSize, fontWeight, fontStyle,
        foreground, textAlignment, wrapping, trimming, lineHeight, selectable]
    events := [linkClick]
    behaviors := [textMeasure, textRender, accessibleText]
+mozEnd
+mozBuiltin TextInput : UiControl
    properties := [text, placeholder, maxLength, readOnly, password,
        multiline, acceptReturn, inputType, selectionStart, selectionLength]
    events := [textChanged, submitted, selectionChanged, validationFailed]
    behaviors := [focusable, keyboardInput, ime, clipboard, accessibleTextField]
+mozEnd
+mozBuiltin Image : UiElement
    properties := [source, fit, alignment, decodeMode, altText, pixelated]
    events := [loaded, failed]
    behaviors := [resourceDecode, imageMeasure, imageRender, accessibleImage]
+mozEnd
+mozBuiltin Panel : UiContainer
    properties := [orientation, spacing, horizontalAlignment, verticalAlignment,
        wrap, overflow, clipToBounds]
    events := []
    behaviors := [childLayout, hitTestChildren]
+mozEnd
+mozBuiltin Stack : Panel
    properties := [orientation, spacing, itemAlignment]
    behaviors := [linearMeasure, linearArrange]
+mozEnd
+mozBuiltin Grid : UiContainer
    properties := [rows, columns, rowGap, columnGap, cellSpacing]
    events := []
    behaviors := [gridMeasure, gridArrange]
+mozEnd
+mozBuiltin ScrollView : UiContainer
    properties := [horizontalScroll, verticalScroll, scrollOffset,
        contentExtent, viewportExtent, overscrollMode]
    events := [scroll, scrollStarted, scrollEnded]
    behaviors := [wheelInput, touchPan, inertia, scrollbarRender]
+mozEnd
+mozBuiltin CheckBox : UiControl
    properties := [isChecked, isThreeState, label, checkAlignment]
    events := [checkedChanged]
    behaviors := [keyboardActivate, accessibleCheckBox]
+mozEnd
+mozBuiltin RadioButton : UiControl
    properties := [groupName, isSelected, label]
    events := [selectionChanged]
    behaviors := [exclusiveSelection, accessibleRadio]
+mozEnd
+mozBuiltin Slider : UiControl
    properties := [minimum, maximum, value, step, orientation, tickFrequency]
    events := [valueChanged, dragStarted, dragCompleted]
    behaviors := [pointerDrag, keyboardAdjust, accessibleSlider]
+mozEnd
+mozBuiltin ProgressBar : UiElement
    properties := [minimum, maximum, value, isIndeterminate, orientation]
    events := [valueChanged]
    behaviors := [progressRender, accessibleProgress]
+mozEnd
+mozBuiltin Border : UiContainer
    properties := [borderBrush, borderThickness, cornerRadius, background, padding]
    events := []
    behaviors := [singleChildLayout, roundedClip]
+mozEnd
+mozBuiltin Separator : UiElement
    properties := [orientation, thickness, brush]
    events := []
    behaviors := [separatorMeasure, separatorRender]
+mozEnd
+mozBuiltin ListView : UiContainer
    properties := [itemsSource, selectedItem, selectedIndex, itemTemplate,
        selectionMode, virtualization, itemSpacing]
    events := [selectionChanged, itemInvoked]
    behaviors := [itemRealization, listNavigation, accessibleList]
+mozEnd
+mozBuiltin Window : UiRoot
    properties := [title, bounds, minimumSize, maximumSize, resizable,
        startupLocation, windowState, topmost, background, icon]
    events := [created, closing, closed, activated, deactivated, resized, moved]
    behaviors := [nativeWindow, focusScope, rootLayout, renderSurface]
+mozEnd

# -----------------------------------------------------------------------------
# 06. Property system, bindings, and validation
# -----------------------------------------------------------------------------
+mozEnum UiPropertyKind
    Boolean
    Integer
    Number
    Text
    Color
    Brush
    Length
    Size
    Point
    Thickness
    Enum
    Resource
    Object
+mozEnd

+mozRecord UiPropertyDescriptor
    name: Text
    kind: UiPropertyKind
    defaultValue: UiValue
    readOnly: Bool = false
    nullable: Bool = false
    affectsMeasure: Bool = false
    affectsArrange: Bool = false
    affectsRender: Bool = false
    affectsAccessibility: Bool = false
    validator: UiValueValidator = None
+mozEnd

+mozRecord UiValidationIssue
    propertyName: Text
    code: Text
    message: Text
    severity: DiagnosticSeverity
+mozEnd
+mozRecord UiValidationResult
    isValid: Bool
    issues: UiValidationIssueList
+mozEnd

+mozInterface IUiValueBinding
    Read() -> UiValue
    Write(value: UiValue) -> UiResult
    Subscribe(callback: UiBindingCallback) -> UiSubscription
    Unsubscribe(subscription: UiSubscription) -> UiResult
+mozEnd

+mozService UiPropertyEngine
    +mozFunction Set(node: IUiNode, name: Text, value: UiValue) -> UiResult
        descriptor := node.GetPropertyDescriptor(name)
        if descriptor == null then return NotFound
        if descriptor.readOnly then return InvalidState
        validation := descriptor.validator.Validate(value)
        if not validation.isValid then return InvalidArgument
        oldValue := node.GetProperty(name)
        if oldValue.Equals(value) then return Ok
        node.StoreProperty(name, value)
        flags := None
        if descriptor.affectsMeasure then flags := flags | Measure
        if descriptor.affectsArrange then flags := flags | Arrange
        if descriptor.affectsRender then flags := flags | Render
        if descriptor.affectsAccessibility then flags := flags | Accessibility
        node.Invalidate(flags)
        node.NotifyPropertyChanged(name, oldValue, value)
        return Ok
    +mozEnd
    +mozFunction Validate(node: IUiNode) -> UiValidationResult
        issues := UiValidationIssueList.Create()
        for each descriptor in node.GetPropertyDescriptors()
            value := node.GetProperty(descriptor.name)
            result := descriptor.validator.Validate(value)
            issues.AppendAll(result.issues)
        end
        return UiValidationResult(issues.Count == 0, issues)
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 07. State, bindings, and update transactions
# -----------------------------------------------------------------------------
+mozEnum UiUpdateMode
    Immediate
    Deferred
    Transaction
+mozEnd

+mozInterface IUiStateStore
    Get(key: Text) -> UiValue
    Set(key: Text, value: UiValue) -> UiResult
    BeginTransaction() -> UiStateTransaction
    Observe(key: Text, callback: UiStateChanged) -> UiSubscription
+mozEnd

+mozService UiStateStore implements IUiStateStore
    values := Map<Text, UiValue>.Create()
    observers := Map<Text, UiObserverList>.Create()
    transactionDepth := 0
    pending := Map<Text, UiValue>.Create()
    +mozFunction Set(key: Text, value: UiValue) -> UiResult
        require key.Length > 0
        if transactionDepth > 0 then
            pending[key] := value
            return Ok
        end
        old := values.GetOrDefault(key, UiValue.Null)
        if old.Equals(value) then return Ok
        values[key] := value
        Notify(key, old, value)
        return Ok
    +mozEnd
    +mozFunction BeginTransaction() -> UiStateTransaction
        transactionDepth := transactionDepth + 1
        return UiStateTransaction.Create(this, transactionDepth)
    +mozEnd
    +mozFunction Commit() -> UiResult
        require transactionDepth > 0
        transactionDepth := transactionDepth - 1
        if transactionDepth == 0 then
            for each key in pending.Keys()
                old := values.GetOrDefault(key, UiValue.Null)
                next := pending[key]
                values[key] := next
                if not old.Equals(next) then Notify(key, old, next)
            end
            pending.Clear()
        end
        return Ok
    +mozEnd
    +mozFunction Rollback() -> UiResult
        require transactionDepth > 0
        transactionDepth := transactionDepth - 1
        if transactionDepth == 0 then pending.Clear()
        return Ok
    +mozEnd
+mozEnd

# Binding rules: source updates are marshalled onto the UI dispatcher. A binding
# must never mutate a node from a worker thread. Cycles are detected and reported.
+mozService UiBindingEngine
    +mozFunction Bind(source: IUiStateStore, key: Text, target: IUiNode, property: Text)
        subscription := source.Observe(key, (value) =>
            dispatcher.Post(() => UiPropertyEngine.Set(target, property, value)))
        target.OnDisposed(() => source.Unobserve(subscription))
        return subscription
    +mozEnd
    +mozFunction BindTwoWay(source: IUiStateStore, key: Text, target: IUiNode, property: Text)
        Bind(source, key, target, property)
        target.ObserveProperty(property, (value) => source.Set(key, value))
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 08. Layout engine: measure, arrange, invalidation
# -----------------------------------------------------------------------------
+mozFlags UiInvalidation
    None = 0
    Measure = 1
    Arrange = 2
    Render = 4
    HitTest = 8
    Accessibility = 16
    All = 31
+mozEnd

+mozInterface IUiLayout
    Measure(node: IUiNode, available: UiSize) -> UiSize
    Arrange(node: IUiNode, finalRect: UiRect) -> UiResult
+mozEnd

+mozService UiLayoutEngine
    +mozFunction Layout(root: IUiNode, viewport: UiSize) -> UiResult
        require root != null
        MeasureTree(root, viewport)
        ArrangeTree(root, UiRect(0, 0, viewport.width, viewport.height))
        return Ok
    +mozEnd
    +mozFunction MeasureTree(node: IUiNode, available: UiSize) -> UiSize
        if node.visibility == Collapsed then return UiSize.Zero
        if not node.IsMeasureDirty() then return node.DesiredSize
        constraints := node.GetMeasureConstraints(available)
        measured := node.Layout.Measure(node, constraints)
        measured.width := clamp(measured.width, node.minWidth, node.maxWidth)
        measured.height := clamp(measured.height, node.minHeight, node.maxHeight)
        node.SetDesiredSize(measured)
        node.ClearInvalidation(Measure)
        return measured
    +mozEnd
    +mozFunction ArrangeTree(node: IUiNode, rect: UiRect) -> UiResult
        if node.visibility == Collapsed then return Ok
        node.SetLayoutBounds(rect)
        result := node.Layout.Arrange(node, rect)
        if result != Ok then return result
        node.ClearInvalidation(Arrange)
        return Ok
    +mozEnd
+mozEnd

+mozService StackLayout implements IUiLayout
    +mozFunction Measure(node: IUiNode, available: UiSize) -> UiSize
        totalMain := 0
        maxCross := 0
        for each child in node.Children where child.visibility != Collapsed
            childSize := UiLayoutEngine.MeasureTree(child, available)
            totalMain := totalMain + MainAxis(childSize) + MainMargins(child)
            maxCross := max(maxCross, CrossAxis(childSize) + CrossMargins(child))
        end
        return ComposeAxes(totalMain + node.spacing * max(0, node.ChildCount - 1), maxCross)
    +mozEnd
    +mozFunction Arrange(node: IUiNode, rect: UiRect) -> UiResult
        cursor := MainStart(rect, node.orientation)
        for each child in node.Children where child.visibility != Collapsed
            size := ResolveChildSize(child, rect, node.orientation)
            childRect := ComposeRect(cursor, CrossStart(rect), size, node.orientation)
            UiLayoutEngine.ArrangeTree(child, childRect)
            cursor := cursor + MainAxis(size) + node.spacing
        end
        return Ok
    +mozEnd
+mozEnd

+mozService GridLayout implements IUiLayout
    +mozFunction Measure(node: IUiNode, available: UiSize) -> UiSize
        columns := ResolveTracks(node.columns, available.width, node.columnGap)
        rows := ResolveTracks(node.rows, available.height, node.rowGap)
        MeasureChildrenIntoCells(node, columns, rows)
        return SumTracks(columns, node.columnGap, rows, node.rowGap)
    +mozEnd
    +mozFunction Arrange(node: IUiNode, rect: UiRect) -> UiResult
        columns := ResolveTracks(node.columns, rect.width, node.columnGap)
        rows := ResolveTracks(node.rows, rect.height, node.rowGap)
        for each child in node.Children
            cell := ResolveGridCell(child.gridRow, child.gridColumn, rows, columns)
            UiLayoutEngine.ArrangeTree(child, cell)
        end
        return Ok
    +mozEnd
+mozEnd

