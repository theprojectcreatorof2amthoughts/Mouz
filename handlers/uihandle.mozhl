# -----------------------------------------------------------------------------
# 18. Animation and transitions
# -----------------------------------------------------------------------------
+mozEnum UiEasing
    Linear
    EaseIn
    EaseOut
    EaseInOut
    CubicBezier
+mozEnd
+mozRecord UiTransition
    property: Text
    from: UiValue
    to: UiValue
    durationMs: UInt32 = 180
    delayMs: UInt32 = 0
    easing: UiEasing = EaseOut
    essential: Bool = false
+mozEnd

+mozService UiAnimationClock
    active: UiTransitionList
    +mozFunction Start(target: IUiNode, transition: UiTransition) -> UiResult
        if Platform.ReduceMotionEnabled() and not transition.essential then
            target.SetProperty(transition.property, transition.to)
            return Ok
        end
        active.Add(UiRunningTransition.Create(target, transition, Clock.Now()))
        return Ok
    +mozEnd
    +mozFunction Tick(now: UInt64) -> UiResult
        for each animation in active snapshot
            progress := animation.ProgressAt(now)
            value := Interpolate(animation.from, animation.to, animation.easing.Apply(progress))
            UiPropertyEngine.Set(animation.target, animation.property, value)
            if progress >= 1 then active.Remove(animation)
        end
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 19. Diagnostics, logging, and error boundaries
# -----------------------------------------------------------------------------
+mozEnum DiagnosticSeverity
    Trace
    Info
    Warning
    Error
    Fatal
+mozEnd
+mozRecord UiDiagnostic
    code: Text
    severity: DiagnosticSeverity
    message: Text
    componentId: Text = ""
    propertyName: Text = ""
    timestamp: UInt64
+mozEnd

+mozService UiDiagnostics
    entries := UiDiagnosticList.Create()
    +mozFunction Report(code: Text, severity: DiagnosticSeverity, message: Text, node: IUiNode = null)
        entry := UiDiagnostic(code, severity, message, node?.id ?? "", "", Clock.Now())
        entries.Append(entry)
        if severity >= Error then Log.Error("Mouz.UI", entry.ToText())
        return entry
    +mozEnd
    +mozFunction Clear() -> UiResult
        entries.Clear()
        return Ok
    +mozEnd
    +mozFunction Snapshot() -> UiDiagnosticList
        return entries.Clone()
    +mozEnd
+mozEnd

+mozService UiErrorBoundary
    +mozFunction Invoke(node: IUiNode, callback: UiCallback) -> UiResult
        try
            callback.Invoke()
            return Ok
        catch error
            UiDiagnostics.Report("UI_CALLBACK_FAILED", Error, error.Message, node)
            node.MarkFaulted(error)
            return InternalError
        end
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 20. Threading, dispatcher, and safe mutation
# -----------------------------------------------------------------------------
+mozInterface IUiDispatcher
    CheckAccess() -> Bool
    Post(callback: UiCallback) -> UiRequest
    Send(callback: UiCallback) -> UiResult
    Drain() -> UiResult
+mozEnd

+mozService UiDispatcher implements IUiDispatcher
    ownerThread := Thread.CurrentId
    queue := ConcurrentQueue<UiCallback>.Create()
    +mozFunction CheckAccess() -> Bool
        return Thread.CurrentId == ownerThread
    +mozEnd
    +mozFunction Post(callback: UiCallback) -> UiRequest
        require callback != null
        request := UiRequest.Create()
        queue.Enqueue(() => request.Complete(callback.Invoke()))
        backend.WakeUiThread()
        return request
    +mozEnd
    +mozFunction Send(callback: UiCallback) -> UiResult
        if CheckAccess() then return callback.Invoke()
        request := Post(callback)
        return request.Wait()
    +mozEnd
    +mozFunction Drain() -> UiResult
        require CheckAccess()
        while queue.TryDequeue(callback)
            UiErrorBoundary.Invoke(null, callback)
        end
        return Ok
    +mozEnd
+mozEnd

# All tree mutation and visual property writes are UI-thread operations. Worker code
# may prepare immutable data and post a callback, but may not touch IUiNode directly.
+mozFunction VerifyUiThread() -> UiResult
    if not UiHandler.dispatcher.CheckAccess() then
        UiDiagnostics.Report("UI_THREAD_VIOLATION", Error, "UI mutation from non-UI thread")
        return InvalidState
    end
    return Ok
+mozEnd

# -----------------------------------------------------------------------------
# 21. Templates, composition, and declarative construction
# -----------------------------------------------------------------------------
+mozInterface IUiTemplate
    GetName() -> Text
    Instantiate(data: UiValue) -> IUiNode
    Validate() -> UiValidationResult
+mozEnd

+mozService UiTemplateRegistry
    templates := Map<Text, IUiTemplate>.Create()
    +mozFunction Register(template: IUiTemplate) -> UiResult
        if templates.Contains(template.GetName()) then return AlreadyExists
        validation := template.Validate()
        if not validation.isValid then return InvalidArgument
        templates[template.GetName()] := template
        return Ok
    +mozEnd
    +mozFunction Instantiate(name: Text, data: UiValue) -> IUiNode
        template := templates.GetOrNull(name)
        if template == null then fail NotFound(name)
        return template.Instantiate(data)
    +mozEnd
+mozEnd

# The .mozf component declaration calls into this factory. The handler owns creation,
# validation, parent-child attachment, property initialization, and lifecycle hooks.
+mozFunction BuildComponent(spec: UiComponentSpec, parent: IUiNode = null) -> IUiNode
    VerifyUiThread()
    node := UiComponentRegistry.Create(spec)
    if node == null then fail InternalError
    result := UiPropertyEngine.ApplyInitialValues(node, spec)
    if result != Ok then
        node.Dispose()
        fail InvalidArgument
    end
    if parent != null then
        result := parent.AddChild(node)
        if result != Ok then
            node.Dispose()
            fail result
        end
    end
    node.OnCreated()
    return node
+mozEnd

# -----------------------------------------------------------------------------
# 22. Window creation entry points
# -----------------------------------------------------------------------------
+mozFunction CreateWindow(spec: WindowSpec) -> UiWindow
    require UiHandler.state == Ready
    require spec.id.Length > 0
    if UiHandler.windows.Get(spec.id) != null then fail AlreadyExists
    root := spec.root ?? UiComponentRegistry.Create(UiComponentSpec(type="Panel", id=spec.id + ".root"))
    handle := UiHandler.backend.CreateNativeWindow(spec)
    if handle == null then fail InternalError
    window := UiWindow.Create(spec, handle, root)
    UiHandler.windows.Add(window)
    root.AttachToTree(window)
    window.LayoutIfDirty()
    window.RenderIfDirty()
    return window
+mozEnd

+mozFunction DestroyWindow(window: UiWindow) -> UiResult
    require window != null
    result := window.Close()
    UiHandler.windows.Remove(window.id)
    return result
+mozEnd

# -----------------------------------------------------------------------------
# 23. Frame pump and application integration
# -----------------------------------------------------------------------------
+mozFunction PumpEvents(timeoutMs: UInt32 = 0) -> UiResult
    require UiHandler.state == Ready
    VerifyUiThread()
    UiHandler.backend.PumpNativeEvents(timeoutMs, (event) => UiInputRouter.HandleInput(event))
    UiDispatcher.Drain()
    UiAnimationClock.Tick(Clock.Now())
    for each window in UiHandler.windows.All()
        window.CommitPendingChanges()
        window.LayoutIfDirty()
        window.RenderIfDirty()
    end
    return Ok
+mozEnd

+mozFunction RunUiLoop() -> UiResult
    require UiHandler.state == Ready
    while UiHandler.state == Ready and UiHandler.windows.Count > 0
        PumpEvents(16)
    end
    return Ok
+mozEnd

# -----------------------------------------------------------------------------
# 24. Public helper API exposed to .mozf source
# -----------------------------------------------------------------------------
+mozPublic Ui
    CreateWindow(spec: WindowSpec) -> UiWindow
    Create(spec: UiComponentSpec, parent: IUiNode = null) -> IUiNode
    Find(root: IUiNode, id: Text) -> IUiNode
    Set(node: IUiNode, property: Text, value: UiValue) -> UiResult
    Bind(store: IUiStateStore, key: Text, node: IUiNode, property: Text) -> UiSubscription
    On(node: IUiNode, eventName: Text, callback: UiEventCallback) -> UiSubscription
    Focus(node: IUiNode) -> UiResult
    ShowDialog(options: UiDialogOptions) -> UiDialogResult
    SetTheme(name: Text) -> UiResult
    Flush() -> UiResult
+mozEnd

# -----------------------------------------------------------------------------
# 25. Default component property metadata
# -----------------------------------------------------------------------------
+mozProperties Button
    text: Text = "" affectsMeasure,Render,Accessibility
    enabled: Bool = true affectsRender,HitTest,Accessibility
    isDefault: Bool = false affectsRender,Accessibility
    isCancel: Bool = false affectsAccessibility
    command: Object = null
    commandParameter: Object = null
    background: Brush = Theme("color.surface") affectsRender
    foreground: Brush = Theme("color.text") affectsRender
    borderBrush: Brush = Theme("color.border") affectsRender
    cornerRadius: Number = Theme("metric.cornerRadius") affectsRender
    padding: Thickness = 12,6 affectsMeasure,Arrange,Render
    fontSize: Number = Theme("metric.fontSize") affectsMeasure,Render
    fontWeight: Enum = SemiBold affectsMeasure,Render
+mozEnd

+mozProperties TextBlock
    text: Text = "" affectsMeasure,Render,Accessibility
    fontFamily: Text = "system-ui" affectsMeasure,Render
    fontSize: Number = 14 affectsMeasure,Render
    fontWeight: Enum = Normal affectsMeasure,Render
    foreground: Brush = Theme("color.text") affectsRender
    textAlignment: Enum = Start affectsRender
    wrapping: Bool = true affectsMeasure,Render
    trimming: Enum = None affectsRender
    selectable: Bool = false affectsHitTest
+mozEnd

+mozProperties TextInput
    text: Text = "" affectsMeasure,Render,Accessibility
    placeholder: Text = "" affectsRender,Accessibility
    maxLength: Integer = 0
    readOnly: Bool = false affectsRender,Accessibility
    password: Bool = false affectsRender,Accessibility
    multiline: Bool = false affectsMeasure,Arrange,Render
    acceptReturn: Bool = false
    inputType: Enum = Text
    selectionStart: Integer = 0 affectsRender
    selectionLength: Integer = 0 affectsRender
    caretBrush: Brush = Theme("color.accent") affectsRender
    selectionBrush: Brush = Theme("color.accent") affectsRender
+mozEnd

+mozProperties Slider
    minimum: Number = 0
    maximum: Number = 100
    value: Number = 0 affectsRender,Accessibility
    step: Number = 1
    orientation: Enum = Horizontal affectsMeasure,Arrange,Render
    tickFrequency: Number = 0 affectsRender
    isSnapToTickEnabled: Bool = false
+mozEnd

# -----------------------------------------------------------------------------
# 26. Default event and keyboard behavior
# -----------------------------------------------------------------------------
+mozBehavior Button
    on PointerDown:
        if not enabled then reject
        FocusManager.Focus(this)
        InputRouter.CapturePointer(event.pointerId, this)
        pressed := true
        Invalidate(Render)
        mark event handled
    on PointerUp:
        wasPressed := pressed
        pressed := false
        InputRouter.ReleasePointer(event.pointerId)
        Invalidate(Render)
        if wasPressed and HitTest(event.position) == this then RaiseEvent("click")
        mark event handled
    on KeyDown Enter or Space:
        pressed := true
        Invalidate(Render)
        mark event handled
    on KeyUp Enter or Space:
        if pressed then RaiseEvent("click")
        pressed := false
        Invalidate(Render)
        mark event handled
+mozEnd

+mozBehavior TextInput
    on TextInput:
        if not readOnly then TextInputService.InsertText(this, event.text)
        mark event handled
    on KeyDown Backspace:
        if not readOnly then TextInputService.DeleteBackward(this)
        mark event handled
    on KeyDown Ctrl+A:
        SetSelection(0, text.Length)
        mark event handled
    on KeyDown Ctrl+C:
        Clipboard.Copy(SelectedText)
        mark event handled
    on KeyDown Ctrl+V:
        if not readOnly then TextInputService.InsertText(this, Clipboard.Paste())
        mark event handled
    on KeyDown Enter:
        if not multiline or not acceptReturn then RaiseEvent("submitted")
        mark event handled
+mozEnd

+mozBehavior Slider
    on PointerDown:
        FocusManager.Focus(this)
        InputRouter.CapturePointer(event.pointerId, this)
        UpdateValueFromPoint(event.position)
        RaiseEvent("dragStarted")
        mark event handled
    on PointerMove when pointerCaptured:
        UpdateValueFromPoint(event.position)
        mark event handled
    on PointerUp:
        InputRouter.ReleasePointer(event.pointerId)
        RaiseEvent("dragCompleted")
        mark event handled
    on KeyDown Left or Down:
        SetValue(value - step)
        mark event handled
    on KeyDown Right or Up:
        SetValue(value + step)
        mark event handled
+mozEnd

# -----------------------------------------------------------------------------
# 27. Layout defaults for built-in containers
# -----------------------------------------------------------------------------
+mozLayout Stack
    Measure := StackLayout.Measure
    Arrange := StackLayout.Arrange
    defaultOrientation := Vertical
    defaultSpacing := 0
    childrenParticipateWhen := visibility == Visible or visibility == Hidden
    collapsedChildrenConsumeSpace := false
+mozEnd

+mozLayout Grid
    Measure := GridLayout.Measure
    Arrange := GridLayout.Arrange
    defaultRows := [Star(1)]
    defaultColumns := [Star(1)]
    defaultRowGap := 0
    defaultColumnGap := 0
    collapsedChildrenConsumeSpace := false
+mozEnd

+mozLayout Border
    Measure := BorderLayout.Measure
    Arrange := BorderLayout.Arrange
    childCount := 1
    paddingConsumesSpace := true
    borderConsumesSpace := true
+mozEnd

+mozLayout ScrollView
    Measure := ScrollLayout.Measure
    Arrange := ScrollLayout.Arrange
    defaultOverflow := Auto
    preserveScrollOffsetOnResize := true
    clampScrollOffsetToContent := true
+mozEnd

# -----------------------------------------------------------------------------
# 28. Resource and theme defaults
# -----------------------------------------------------------------------------
+mozResourcePolicy Default
    maxResourceCount := 4096
    maxImageBytes := 33554432
    maxFontBytes := 16777216
    allowRemoteResources := false
    allowDataUris := true
    cacheDecodedImages := true
    cacheFonts := true
    releaseUnusedAfterFrames := 120
+mozEnd

+mozThemeTokens Common
    color.window
    color.surface
    color.surfaceAlt
    color.text
    color.textMuted
    color.accent
    color.accentText
    color.border
    color.focus
    color.danger
    metric.controlHeight
    metric.cornerRadius
    metric.spacing
    metric.fontSize
+mozEnd

# -----------------------------------------------------------------------------
# 29. Runtime invariants
# -----------------------------------------------------------------------------
+mozInvariant UI001
    every attached node has exactly one parent
    root nodes have no parent
    a node cannot be its own ancestor
+mozEnd
+mozInvariant UI002
    disposed nodes cannot be attached, rendered, or receive input
+mozEnd
+mozInvariant UI003
    all visual tree mutations occur on the UI thread
+mozEnd
+mozInvariant UI004
    layout runs before rendering after measure or arrange invalidation
+mozEnd
+mozInvariant UI005
    hidden nodes retain layout space but do not render or receive hit tests
    collapsed nodes do not retain layout space
+mozEnd
+mozInvariant UI006
    pointer capture is released on pointer up, cancel, and node disposal
+mozEnd
+mozInvariant UI007
    event routing order is capture, target, then bubble
+mozEnd
+mozInvariant UI008
    failed component construction disposes the partially created node
+mozEnd
+mozInvariant UI009
    resource paths are validated before loading
+mozEnd
+mozInvariant UI010
    every public operation returns a UiResult or raises a typed Mouz diagnostic
+mozEnd

# -----------------------------------------------------------------------------
# 30. Test hooks and deterministic headless mode
# -----------------------------------------------------------------------------
+mozService UiTestHooks
    enabled := false
    +mozFunction Enable() -> UiResult
        require Platform.IsDebugBuild()
        enabled := true
        return Ok
    +mozEnd
    +mozFunction CreateHeadlessWindow(size: UiSize) -> UiWindow
        require enabled
        UiHandlerOptions.backend := Headless
        return CreateWindow(WindowSpec(id=UniqueId(), bounds=UiRect(0, 0, size.width, size.height)))
    +mozEnd
    +mozFunction SnapshotTree(root: IUiNode) -> Text
        require enabled
        return UiTreeSerializer.Serialize(root, includeLayout=true, includeProperties=true)
    +mozEnd
    +mozFunction AssertLayout(node: IUiNode, expected: UiRect) -> UiResult
        require enabled
        if not node.Bounds.NearlyEquals(expected, 0.5) then return InvalidState
        return Ok
    +mozEnd
+mozEnd

+mozTest "handler initializes exactly once"
    assert UiHandler.Initialize(UiHandlerOptions(backend=Headless)) == Ok
    assert UiHandler.GetState() == Ready
    assert UiHandler.Initialize(UiHandlerOptions(backend=Headless)) == InvalidState
    assert UiHandler.Shutdown() == Ok
+mozEnd

+mozTest "component tree rejects cycles"
    root := BuildComponent(UiComponentSpec(id="root", type="Panel"))
    child := BuildComponent(UiComponentSpec(id="child", type="Button"), root)
    assert root.AddChild(child) == AlreadyExists
    assert child.AddChild(root) == InvalidArgument
    root.Dispose()
+mozEnd

+mozTest "property changes invalidate rendering"
    button := BuildComponent(UiComponentSpec(id="save", type="Button"))
    assert button.SetProperty("text", "Save") == Ok
    assert button.IsRenderDirty()
    button.Dispose()
+mozEnd

+mozTest "headless layout is deterministic"
    root := BuildComponent(UiComponentSpec(id="root", type="Stack"))
    root.AddChild(BuildComponent(UiComponentSpec(id="a", type="TextBlock")))
    root.AddChild(BuildComponent(UiComponentSpec(id="b", type="Button")))
    assert UiLayoutEngine.Layout(root, UiSize(400, 300)) == Ok
    assert root.Bounds == UiRect(0, 0, 400, 300)
    root.Dispose()
+mozEnd

# -----------------------------------------------------------------------------
# 31. Extension points for future controls and platform services
# -----------------------------------------------------------------------------
+mozInterface IUiControlExtension
    RegisterComponents(registry: UiComponentRegistry) -> UiResult
    RegisterThemes(catalog: UiThemeCatalog) -> UiResult
    RegisterResources(store: UiResourceStore) -> UiResult
    Shutdown() -> UiResult
+mozEnd

+mozInterface IUiPlatformService
    GetPlatformName() -> Text
    GetCapabilities() -> UiCapabilities
    OpenExternal(uri: Text) -> UiResult
    GetSystemMetric(name: Text) -> Float
    GetSystemColor(name: Text) -> UiColor
+mozEnd

+mozService UiExtensionManager
    extensions := UiExtensionList.Create()
    +mozFunction Register(extension: IUiControlExtension) -> UiResult
        require extension != null
        result := extension.RegisterComponents(UiComponentRegistry)
        if result != Ok then return result
        result := extension.RegisterThemes(UiThemeCatalog)
        if result != Ok then return result
        result := extension.RegisterResources(UiResourceStore)
        if result != Ok then return result
        extensions.Append(extension)
        return Ok
    +mozEnd
    +mozFunction Shutdown() -> UiResult
        for each extension in extensions.Reverse()
            extension.Shutdown()
        end
        extensions.Clear()
        return Ok
    +mozEnd
+mozEnd

# -----------------------------------------------------------------------------
# 32. Initialization wiring
# -----------------------------------------------------------------------------
+mozFunction RegisterBuiltInComponents() -> UiResult
    UiComponentRegistry.Register(ButtonFactory.Create())
    UiComponentRegistry.Register(TextBlockFactory.Create())
    UiComponentRegistry.Register(TextInputFactory.Create())
    UiComponentRegistry.Register(ImageFactory.Create())
    UiComponentRegistry.Register(PanelFactory.Create())
    UiComponentRegistry.Register(StackFactory.Create())
    UiComponentRegistry.Register(GridFactory.Create())
    UiComponentRegistry.Register(ScrollViewFactory.Create())
    UiComponentRegistry.Register(CheckBoxFactory.Create())
    UiComponentRegistry.Register(RadioButtonFactory.Create())
    UiComponentRegistry.Register(SliderFactory.Create())
    UiComponentRegistry.Register(ProgressBarFactory.Create())
    UiComponentRegistry.Register(BorderFactory.Create())
    UiComponentRegistry.Register(SeparatorFactory.Create())
    UiComponentRegistry.Register(ListViewFactory.Create())
    UiComponentRegistry.Register(WindowFactory.Create())
    return Ok
+mozEnd

+mozFunction InitializeUiHandler(options: UiHandlerOptions) -> UiResult
    result := UiHandler.Initialize(options)
    if result != Ok then return result
    result := RegisterBuiltInComponents()
    if result != Ok then
        UiHandler.Shutdown()
        return result
    end
    UiHandler.themes.SetTheme(options.themeName)
    return Ok
+mozEnd

# End of Mouz UI Handler Core draft.
# This file defines the handler surface and behavior contract; native and browser
# bridge implementations must satisfy these interfaces in the Mouz runtime.
